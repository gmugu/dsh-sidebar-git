{
  "name": "dsh-sidebar-git",
  "version": "0.1.3",
  "description": "Standalone Git panel tab for the DSH native right sidebar, extracted from dsh-better-sidebar's changes-tab Git lens (MIT, omdsh-dev/DSH-better-sidebar).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "node build/build.js"
  },
  "devDependencies": {
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "esbuild-wasm": "^0.28.2"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
