{
  "name": "dsh-sidebar-git",
  "version": "0.2.3",
  "description": "Standalone Git panel tab for the DSH native right sidebar.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*": "./locale/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-shortcuts"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": "gmugu",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "git",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmugu/dsh-sidebar-git.git"
  },
  "homepage": "https://github.com/gmugu/dsh-sidebar-git#readme",
  "bugs": {
    "url": "https://github.com/gmugu/dsh-sidebar-git/issues"
  },
  "files": [
    "lib",
    "locale",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build/build.js",
    "probe": "node build/probe/run.mjs"
  },
  "devDependencies": {
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  }
}
